{
  "name": "overload-reminder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alt1 plugin that warns you before your Overload buff runs out.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/check-gate.mjs --bundle --platform=node --format=esm --outfile=dist/check-gate.mjs --log-level=warning && node dist/check-gate.mjs"
  },
  "dependencies": {
    "alt1": "^0.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
